# Copy to .env for local development. Every value below is validated at startup;
# the process refuses to boot rather than failing at the first request.

# ── required ────────────────────────────────────────────────────────────────

# PostgreSQL 16 with PostGIS 3.
DATABASE_URL=postgres://cmdev@127.0.0.1:5432/cm_dev

# The site this API belongs to: scheme://host[:port], no path, no trailing
# slash. Compared against the Origin header on state-changing requests, and
# required to be https in production because __Host- cookies need Secure.
CM_SITE_ORIGIN=http://localhost:3000

# Keys the digests of values that must not be stored in the clear (client IP
# addresses, rate-limit bucket keys) and derives CSRF tokens. At least 32
# characters. Generate with: openssl rand -base64 48
# Rotating it invalidates outstanding CSRF tokens; it does not log anyone out.
CM_HASH_PEPPER=change-me-to-at-least-32-random-characters

# ── optional ────────────────────────────────────────────────────────────────

# development | staging | production. Default: development.
CM_ENV=development

# Default: 127.0.0.1:8080
CM_BIND_ADDR=127.0.0.1:8080

# json | pretty. Default: pretty in development, json elsewhere.
CM_LOG_FORMAT=pretty

# Connection pool. Defaults: 16 connections, 5 s acquire timeout.
CM_DB_MAX_CONNECTIONS=16
CM_DB_ACQUIRE_TIMEOUT_SECS=5

# Seconds to let in-flight requests finish on SIGTERM. Default: 15.
CM_SHUTDOWN_GRACE_SECS=15

# Session lifetimes. Idle is rolling, absolute is a hard ceiling; idle must not
# exceed absolute. Defaults: 14 and 90 days.
CM_SESSION_IDLE_DAYS=14
CM_SESSION_ABSOLUTE_DAYS=90

# Concurrent Argon2 hashes. Each holds ~19 MiB while it runs, so this is a
# memory budget as much as a CPU one. Default: 4.
CM_ARGON2_MAX_CONCURRENCY=4

# ── Google sign-in (optional) ───────────────────────────────────────────────

# Set to enable POST /v1/auth/google. Without it the endpoint answers
# "not configured" rather than half-working. Only Google's public keys are
# needed to verify a token, so no service-account credential goes here.
# FIREBASE_PROJECT_ID=cm-marketplace

# Local development against the Firebase Auth emulator ONLY. Emulator tokens
# are unsigned; the process refuses to start if this is set with CM_ENV=production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── proxy ───────────────────────────────────────────────────────────────────

# Whether X-Forwarded-For may be believed when identifying a client. Default:
# false. Even when true, the header is only believed if the immediate socket
# peer is loopback — the deployment is exactly one Caddy hop on 127.0.0.1, and
# that boundary is enforced in code rather than left to the firewall. A request
# arriving from anywhere else is attributed to its own socket address whatever
# headers it sends.
CM_TRUST_PROXY_HEADERS=false
